
import numpy as np
import matplotlib.pyplot as plt

# 1. Define Input Sequence
X = np.array([1, 2, 3, 4, 5])

# 2. Initialize Weights and Bias
Wx = 0.5
Wh = 0.8
b = 0.1

# 3. Initialize Hidden State
h = 0

hidden_states = []

# 4. RNN Forward Propagation
for t in range(len(X)):

    h = np.tanh(Wx * X[t] + Wh * h + b)

    hidden_states.append(h)

    print("Time Step:", t + 1)
    print("Input:", X[t])
    print("Hidden State:", round(h, 4))
    print()

# 5. Visualize Input Sequence
plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)

plt.plot(range(1, 6), X, marker='o')

plt.title("RNN Input Sequence")
plt.xlabel("Time Steps")
plt.ylabel("Input Values")
plt.grid()

# 6. Visualize Hidden States
plt.subplot(1, 2, 2)

plt.plot(
    range(1, 6),
    hidden_states,
    marker='s',
    color='red'
)

plt.title("RNN Hidden States")
plt.xlabel("Time Steps")
plt.ylabel("Hidden State Values")
plt.grid()

plt.tight_layout()
plt.show()

# 7. Visualize Unfolded RNN Architecture
fig, ax = plt.subplots(figsize=(12, 4))

for t in range(5):

    ax.text(t, 0.5, f"RNN\nStep {t+1}",
            ha='center', va='center',
            bbox=dict(boxstyle='round', facecolor='lightblue'))

    ax.text(t, 0.1, f"X{t+1}",
            ha='center', va='center')

    if t < 4:
        ax.annotate(
            "",
            xy=(t+0.75, 0.5),
            xytext=(t+0.25, 0.5),
            arrowprops=dict(arrowstyle='->')
        )

    ax.annotate(
        "",
        xy=(t, 0.35),
        xytext=(t, 0.22),
        arrowprops=dict(arrowstyle='->')
    )

ax.set_xlim(-0.5, 4.5)
ax.set_ylim(-0.1, 1)
ax.set_title("Unfolded RNN Architecture")
ax.axis('off')

plt.show()
