
import numpy as np
import matplotlib.pyplot as plt
from sklearn.datasets import load_iris
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.metrics import mean_squared_error

# 1. Load Dataset
iris = load_iris()
X = iris.data

print("Original Dataset Shape:", X.shape)

# 2. Standardize Dataset
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# 3. Apply Probabilistic PCA
pca = PCA(
    n_components=2,
    svd_solver='full'
)

# Fit PCA Model
X_reduced = pca.fit_transform(X_scaled)

print("\nReduced Dataset Shape:", X_reduced.shape)

# 4. Display Explained Variance
print("\nExplained Variance Ratio:")
print(pca.explained_variance_ratio_)

print("\nTotal Explained Variance:")
print(np.sum(pca.explained_variance_ratio_))

# 5. Reconstruct Original Data
X_reconstructed = pca.inverse_transform(X_reduced)

print("\nReconstructed Dataset Shape:")
print(X_reconstructed.shape)

# 6. Calculate Reconstruction Error
mse = mean_squared_error(
    X_scaled,
    X_reconstructed
)

print("\nReconstruction Error (MSE):")
print(mse)

# 7. Visualize Original and Reconstructed Data
plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
plt.scatter(
    X_scaled[:, 0],
    X_scaled[:, 1]
)
plt.title("Original Dataset")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.grid()

plt.subplot(1, 2, 2)
plt.scatter(
    X_reconstructed[:, 0],
    X_reconstructed[:, 1],
    color='red'
)
plt.title("Reconstructed Dataset")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.grid()

plt.tight_layout()
plt.show()

# 8. Visualize Reconstruction Error
plt.figure(figsize=(8, 5))

plt.bar(
    ["Reconstruction Error"],
    [mse]
)

plt.title("PPCA Reconstruction Error")
plt.ylabel("Mean Squared Error")
plt.grid(axis='y')
plt.show()

# 9. Compare Different Components
errors = []

for n in range(1, 5):

    model = PCA(n_components=n)
    reduced = model.fit_transform(X_scaled)

    reconstructed = model.inverse_transform(reduced)

    error = mean_squared_error(
        X_scaled,
        reconstructed
    )

    errors.append(error)

    print("Components:", n,
          "Reconstruction Error:", round(error, 5))

# 10. Plot Component Comparison
plt.figure(figsize=(8, 5))

plt.plot(
    range(1, 5),
    errors,
    marker='o'
)

plt.xlabel("Number of Components")
plt.ylabel("Reconstruction Error")
plt.title("PCA Reconstruction Error Comparison")
plt.xticks(range(1, 5))
plt.grid()
plt.show()
